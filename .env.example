# Copia este archivo como .env para cambiar la configuración local. Todo es opcional.

# Sin DATABASE_URL, el servidor usa PGlite en apps/api/.datos/ y carga la demostración.
# Con el contenedor local (vp run db), descomenta esta línea:
# DATABASE_URL=postgres://panal:panal@127.0.0.1:5432/panal

# Puerto del servidor de la API. La aplicación web lo espera en 8787.
# PORT=8787
